<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.heart">
	<select id="selectHeart" parameterType="Map" resultType="Integer">
		select num from heart where article_num=#{articleNum} and member_id=#{memberId}
	</select>
	
	<insert id="insertHeart" parameterType="Map">
		insert into heart (article_num, member_id) values(#{articleNum}, #{memberId})
	</insert>
	
	<delete id="deleteHeart" parameterType="Map">
		delete from heart where article_num=#{articleNum} and member_id=#{memberId}
	</delete>
</mapper>